{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build Pipeline Models project manifest",
  "type": "object",
  "required": [
    "standard",
    "name",
    "current_phase",
    "profile",
    "process_models",
    "steps"
  ],
  "properties": {
    "standard": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "current_phase": {
      "type": "string",
      "pattern": "^P([0-9]|1[01])$"
    },
    "profile": {
      "type": "string",
      "pattern": "^T(0[1-9]|10)$"
    },
    "deploy_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^D(0[1-9]|1[0-4])$"
      }
    },
    "process_models": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^M(0[1-9]|1[0-9]|2[0-6])$"
      }
    },
    "steps": {
      "type": "object",
      "propertyNames": {
        "pattern": "^P([0-9]|1[01])\\.[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "todo",
              "doing",
              "done",
              "n/a"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
